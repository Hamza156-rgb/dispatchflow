// DispatchFlow - Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  password    String
  companyName String
  phoneNumber String?
  logoUrl     String?
  address     String?
  taxNumber   String?
  resetToken  String?
  resetTokenExpiry DateTime?
  plan        String   @default("STARTER")
  // Multi-tenant + roles
  ownerId       String?   // null = org owner; set = team member belonging to that owner
  role          String    @default("OWNER")   // OWNER | MEMBER
  isSuperAdmin  Boolean   @default(false)
  accountStatus String    @default("ACTIVE")  // PENDING | ACTIVE | SUSPENDED (on the owner)
  // Manual billing cycle (on the owner)
  currentPeriodEnd DateTime?  // "paid until" — next payment is due on this date
  lastPaymentAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients     Client[]
  invoices    Invoice[]
  loads       Load[]
  loadBoardCredentials LoadBoardCredential[]

  @@index([email])
  @@index([ownerId])
}

// A dispatcher's own load-board account (e.g. their DAT subscription).
// Credentials are per-user, not per-workspace: load boards license access by
// seat, so every dispatcher connects the subscription they personally hold.
model LoadBoardCredential {
  id           String    @id @default(cuid())
  provider     String                        // "DAT" — more providers later
  accountLabel String?                       // shown in the UI ("DAT — dispatch@acme.com")
  // AES-256-GCM ciphertext. Never leaves the backend, never sent to the client.
  usernameEnc  String
  secretEnc    String
  // Cached provider access token so we don't re-authenticate on every search.
  tokenEnc     String?
  tokenExpiry  DateTime?
  lastUsedAt   DateTime?
  lastError    String?                       // last auth/search failure, surfaced in Settings
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([userId, provider, updatedAt])
}

// Admin-managed plan catalog. Existing users still store a plan code in `User.plan`,
// but the display name, price, and seat limit come from here.
model PricingPlan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  tagline     String?
  description String?
  price       Int
  userLimit   Int
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  features    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model Client {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String
  email         String
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  loads         Load[]

  @@index([userId])
  @@index([companyName])
  @@index([userId, companyName])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  issueDate     DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxRate       Decimal       @db.Decimal(5, 2) @default(0)
  taxAmount     Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(10, 2)
  notes         String?
  terms         String?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([userId, invoiceNumber])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([clientId])
  @@index([userId, dueDate])
  @@index([userId, clientId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  rate        Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)

  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime
  paymentMethod PaymentMethod
  referenceNumber String?
  notes         String?
  createdAt     DateTime      @default(now())

  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Load {
  id            String        @id @default(cuid())
  loadNumber    String
  // Route
  originCity    String?
  originState   String?
  destCity      String?
  destState     String?
  // Schedule
  pickupAt      DateTime?
  deliveryAt    DateTime?
  // Money
  miles         Decimal?      @db.Decimal(10, 2)
  rate          Decimal       @db.Decimal(10, 2)
  // Freight details
  equipment     String?
  weight        String?
  commodity     String?
  driver        String?
  referenceNumber String?
  // Lifecycle
  status        LoadStatus    @default(PENDING)
  paymentStatus LoadPaymentStatus @default(UNPAID)
  notes         String?
  // Provenance — where this load came from
  source        LoadSource    @default(MANUAL)
  externalId    String?       // provider's own load id; dedupes repeat imports
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])

  @@unique([userId, loadNumber])
  // Postgres treats NULLs as distinct, so manual loads (externalId = null)
  // are unconstrained while imported ones can only land once per user.
  @@unique([userId, externalId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, paymentStatus])
  @@index([userId, pickupAt])
  @@index([userId, clientId])
  @@index([clientId])
}

enum LoadStatus {
  PENDING
  ACTIVE
  DELIVERED
  CANCELLED
}

enum LoadPaymentStatus {
  UNPAID
  PAID
}

enum LoadSource {
  MANUAL   // typed into the load form
  CSV      // bulk CSV upload
  PASTE    // pasted from an email / load sheet and parsed
  DAT      // imported from the DAT load board API
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CASH
  CREDIT_CARD
  ACH
  OTHER
}
