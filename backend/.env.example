# Backend environment — copy to `.env` and fill in your values
# PostgreSQL connection string
DATABASE_URL="postgresql://dispatchflow:dispatchflow_secret@localhost:5432/dispatchflow"

# Secret for signing JWTs (use a long random string, 32+ chars)
JWT_SECRET="change-me-to-a-long-random-secret"

# API server port
PORT=5000

# CORS origin (frontend URL). Any localhost port is also allowed in dev.
FRONTEND_URL="http://localhost:5173"

# SMTP (optional — only needed for the "email invoice" feature)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Load board integration ───────────────────────────────────────────────────
# Encrypts stored load-board credentials (AES-256-GCM). Falls back to
# JWT_SECRET if unset, but set it explicitly in production: rotating
# JWT_SECRET would otherwise make every saved credential undecryptable.
ENCRYPTION_KEY=

# Shows the Load Board page at all. Off by default so production never asks
# customers for a real load-board password it can't actually use. Setting
# LOADBOARD_PROVIDER to a live provider turns it on regardless; set this to
# `true` to run the page against mock data for demos and local development.
LOADBOARD_ENABLED=false

# `mock` (default) serves synthetic postings so the Load Board page works
# without a DAT account. Set to `dat` once the API agreement is signed.
LOADBOARD_PROVIDER=mock

# DispatchFlow's own DAT API service account, from the DAT API agreement.
# Individual dispatchers still connect their own DAT login in the app —
# this service account only vouches for us when minting their user token.
DAT_SERVICE_USERNAME=
DAT_SERVICE_PASSWORD=

# Endpoint overrides — set these to whatever DAT's docs specify for your
# contract. The defaults in src/services/loadboard/dat.ts follow DAT's
# published pattern but have NOT been verified against a live account.
DAT_IDENTITY_URL=
DAT_FREIGHT_URL=
DAT_ORG_TOKEN_PATH=
DAT_USER_TOKEN_PATH=
DAT_SEARCH_PATH=
DAT_TIMEOUT_MS=20000
